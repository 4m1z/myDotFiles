# myDotFiles zsh profile. Sourced by .zshrc. Portable, no secrets.
export XDG_CONFIG_HOME="$HOME/.config"
VIM="nvim"

export GIT_EDITOR=$VIM

# Wi-Fi interface for throttle helpers. Override per machine, e.g.
#   export WIFI_IFACE=wlan0
# in ~/.config/opencode/secrets.zsh or similar. Auto-detected when unset.
_wifi_iface() {
  if [[ -n "${WIFI_IFACE:-}" ]]; then
    print -r -- "$WIFI_IFACE"
    return 0
  fi
  local dev
  dev=$(iw dev 2>/dev/null | awk '/Interface/ {print $2; exit}')
  if [[ -z "$dev" ]]; then
    echo "no wireless interface found (set WIFI_IFACE)" >&2
    return 1
  fi
  print -r -- "$dev"
}

addThrottle() {
  local iface kbs="kbps"
  iface=$(_wifi_iface) || return 1
  echo "About to throttle $iface to $1 $kbs"
  sudo tc qdisc add dev "$iface" handle 1: root htb default 11
  sudo tc class add dev "$iface" parent 1: classid 1:1 htb rate "$1$kbs"
  sudo tc class add dev "$iface" parent 1:1 classid 1:11 htb rate "$1$kbs"
}

removeThrottle() {
  local iface
  iface=$(_wifi_iface) || return 1
  sudo tc qdisc del dev "$iface" root
}

catr() {
    tail -n "+$1" $3 | head -n "$(($2 - $1 + 1))"
}

validateYaml() {
    python -c 'import yaml,sys;yaml.safe_load(sys.stdin)' < $1
}

goWork() {
    cp ~/.npm_work_rc ~/.npmrc
}

goPersonal() {
    cp ~/.npm_personal_rc ~/.npmrc
}

cat1Line() {
    cat $1 | tr -d "\n"
}

ioloop() {
    FIFO=$(mktemp -u /tmp/ioloop_$$_XXXXXX ) &&
    trap "rm -f $FIFO" EXIT &&
    mkfifo $FIFO &&
    ( : <$FIFO & ) &&    # avoid deadlock on opening pipe
    exec >$FIFO <$FIFO
}

eslintify() {
    cat $1 > /tmp/file_to_eslint
    npx eslint
}

### openai
# API keys load from ~/.config/opencode/secrets.zsh (never committed).
# See opencode/secrets.zsh.example. Example:
# export OPENAI_API_KEY="..."
