{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "foreground": "#FFFFFF",
    "foregroundDark": "#A8BDD2",
    "foregroundLight": "#DCE9F5",
    "muted": "#7BA2C7",
    "red": "#FF7B72",
    "redBright": "#FFA198",
    "yellow": "#FFD166",
    "orange": "#FFAB70",
    "green": "#7EE787",
    "greenBright": "#A7F3AD",
    "cyan": "#72E6E6",
    "blue": "#73B7FF",
    "blueBright": "#A8D4FF",
    "magenta": "#D6A8FF"
  },
  "theme": {
    "primary": "blue",
    "secondary": "cyan",
    "accent": "foreground",
    "error": "red",
    "warning": "yellow",
    "success": "green",
    "info": "blue",
    "text": "foreground",
    "textMuted": "foregroundDark",
    "background": "none",
    "backgroundPanel": "none",
    "backgroundElement": "none",
    "border": "blue",
    "borderActive": "foreground",
    "borderSubtle": "muted",
    "diffAdded": "green",
    "diffRemoved": "red",
    "diffContext": "foregroundDark",
    "diffHunkHeader": "cyan",
    "diffHighlightAdded": "greenBright",
    "diffHighlightRemoved": "redBright",
    "diffAddedBg": "none",
    "diffRemovedBg": "none",
    "diffContextBg": "none",
    "diffLineNumber": "muted",
    "diffAddedLineNumberBg": "none",
    "diffRemovedLineNumberBg": "none",
    "markdownText": "foreground",
    "markdownHeading": "blueBright",
    "markdownLink": "cyan",
    "markdownLinkText": "blue",
    "markdownCode": "green",
    "markdownBlockQuote": "foregroundDark",
    "markdownEmph": "orange",
    "markdownStrong": "yellow",
    "markdownHorizontalRule": "blue",
    "markdownListItem": "cyan",
    "markdownListEnumeration": "yellow",
    "markdownImage": "magenta",
    "markdownImageText": "cyan",
    "markdownCodeBlock": "foregroundLight",
    "syntaxComment": "muted",
    "syntaxKeyword": "magenta",
    "syntaxFunction": "blue",
    "syntaxVariable": "foreground",
    "syntaxString": "green",
    "syntaxNumber": "orange",
    "syntaxType": "yellow",
    "syntaxOperator": "cyan",
    "syntaxPunctuation": "foregroundLight"
