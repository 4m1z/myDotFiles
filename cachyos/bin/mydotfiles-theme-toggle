#!/usr/bin/env bash
# Toggle Noctalia light/dark mode and record the resolved mode for
# distro-neutral consumers (Neovim system_theme.lua reads this file).
# Native Noctalia IPC; verified syntax Oct 2026:
#   noctalia msg theme-mode-toggle
#   noctalia msg theme-mode-get        -> prints dark|light
#   noctalia msg theme-mode-set dark|light|auto
set -euo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/mydotfiles"
STATE_FILE="$STATE_DIR/theme"

usage() {
  printf 'Usage: %s [toggle|dark|light|auto|status]\n' "$(basename "$0")" >&2
}

record_state() {
  local mode=$1
  mkdir -p -- "$STATE_DIR"
  {
    printf 'mode=%s\n' "$mode"
    printf 'updated=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  } >"$STATE_FILE.tmp"
  mv -- "$STATE_FILE.tmp" "$STATE_FILE"
}

current_mode() {
  if command -v noctalia >/dev/null 2>&1; then
    noctalia msg theme-mode-get 2>/dev/null || true
  fi
}

main() {
  local action=${1:-toggle}
  if ! command -v noctalia >/dev/null 2>&1; then
    printf 'mydotfiles-theme-toggle: noctalia not found\n' >&2
    exit 1
  fi
  case "$action" in
    toggle) noctalia msg theme-mode-toggle ;;
    dark | light | auto) noctalia msg theme-mode-set "$action" ;;
    status) current_mode; return 0 ;;
    -h | --help) usage; return 0 ;;
    *)
      usage
      exit 1
      ;;
  esac
  # Record the resolved mode (best effort: never fail the toggle itself).
  local mode
  mode=$(current_mode) || true
  if [[ "$mode" == "dark" || "$mode" == "light" ]]; then
    record_state "$mode" || true
  fi
}

main "$@"
